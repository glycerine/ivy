{
  "name": "@ivy/gojr",
  "private": true,
  "type": "module",
  "bin": {
    "gojr": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "run": "node dist/src/cli.js run",
    "test": "rm -rf /tmp/gojr-test-dist && tsc -p tsconfig.test.json && GOJR_TEST_PROGRESS=1 node --test /tmp/gojr-test-dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.3"
  }
}
