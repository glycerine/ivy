~py[after i=13237975]: invariant [l2s_needed_implies_created[1]] true -> (true -> true)
~py[after i=13237975]: invariant [l2s_work_preserved[1]] (l2s_saved & ($l2s_s . true -> false)) -> (true -> false)
~py[after i=13237975]: invariant [l2s_progress_made[1]] ((~($l2s_s . true -> false) & ~~(forall T. $l2s_s T:lclock. ((ref.evs.req(T) = read & rfn.evqual(_M,T)) & ref.evs.a(T) = _A) -> false(T))) & l2s_saved & true & ~($l2s_w . dramc_nb2.push_trying_rd(_M,_A))) -> (~($l2s_s . true -> false) & (true -> false))
