~go[after i=25330996]: --- begin l2s_auto invariants ---
~go[after i=25330996]: 
~go[after i=25330996]: invariant [l2s_needed_when_start] (($l2s_init . ⬦ ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))) & (~l2s_waiting | ~($l2s_w . ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))))) -> (ref.evs.mem_loc(_T) = mem_memc -> true)
~go[after i=25330996]: invariant [l2s_created] true -> true
~go[after i=25330996]: invariant [l2s_needed_are_frozen] (($l2s_init . ⬦ ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))) & ~l2s_waiting) -> (ref.evs.mem_loc(_T) = mem_memc -> true)
~go[after i=25330996]: invariant [l2s_done_implies_created] false -> true
~go[after i=25330996]: invariant [l2s_needed_implies_created] (($l2s_init . ⬦ ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))) & (~l2s_waiting | ~($l2s_w . ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))))) -> (ref.evs.mem_loc(_T) = mem_memc -> true)
~go[after i=25330996]: invariant [l2s_work_preserved] (l2s_saved & ($l2s_s . false)) -> false
~go[after i=25330996]: invariant [l2s_progress_made] ((~(ref.evs.mem_loc(_T) = mem_memc -> ($l2s_s . false)) & ~false) & l2s_saved & ($l2s_init . ⬦ ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))) & ~($l2s_w . cmpl_live.cf_cpl(_T))) -> (~($l2s_s . false) & false)
~go[after i=25330996]: invariant [l2s_progress_invar] ($l2s_init . □ ⬦ cmpl_live.cf_cpl(_T)) -> □ ⬦ cmpl_live.cf_cpl(_T)
~go[after i=25330996]: invariant [l2s_needed_when_start[2]] true -> (ref.evs.mem_loc(_T) = pio_memc -> true)
~go[after i=25330996]: invariant [l2s_created[2]] true -> true
~go[after i=25330996]: invariant [l2s_needed_are_frozen[2]] (true & ~l2s_waiting) -> (ref.evs.mem_loc(_T) = pio_memc -> true)
~go[after i=25330996]: invariant [l2s_done_implies_created[2]] false -> true
~go[after i=25330996]: invariant [l2s_needed_implies_created[2]] true -> (ref.evs.mem_loc(_T) = pio_memc -> true)
~go[after i=25330996]: invariant [l2s_work_preserved[2]] (l2s_saved & ($l2s_s . false)) -> false
~go[after i=25330996]: invariant [l2s_progress_made[2]] ((~(ref.evs.mem_loc(_T) = pio_memc -> ($l2s_s . false)) & ~~(ref.evs.mem_loc(_T) = mem_memc -> ($l2s_s . false))) & l2s_saved & true & ~($l2s_w . ref.evs.l_cmp(_T) = cf_cmp_l)) -> (~($l2s_s . false) & false)
~go[after i=25330996]: invariant [l2s_progress_invar[2]] ($l2s_init . □ ⬦ ref.evs.l_cmp(_T) = cf_cmp_l) -> □ ⬦ ref.evs.l_cmp(_T) = cf_cmp_l
~go[after i=25330996]: invariant [l2s_not_all_done] ~(($l2s_init . ⬦ ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))) & (~l2s_waiting | ~($l2s_w . ~((_M = ref.evs.m(_T) & _A = ref.evs.a(_T)) -> (e2e.issued_to_cf(_P,_T) -> ⬦ cmpl_live.cf_cpl(_T)))))) | ~(⬦ cmpl_live.cf_cpl(_T) -> (ref.evs.mem_loc(_T) = mem_memc -> false)) | (~true | ~(⬦ ref.evs.l_cmp(_T) = cf_cmp_l -> (ref.evs.mem_loc(_T) = pio_memc -> false)))
