~go[after i=22704091]: invariant [l2s_needed_when_start] (($l2s_init . ⬦ ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))) & (~l2s_waiting | ~($l2s_w . ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))))) -> (true -> true)
~go[after i=22704091]: invariant [l2s_created] true -> true
~go[after i=22704091]: invariant [l2s_needed_are_frozen] (($l2s_init . ⬦ ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))) & ~l2s_waiting) -> (true -> true)
~go[after i=22704091]: invariant [l2s_done_implies_created] false -> true
~go[after i=22704091]: invariant [l2s_needed_implies_created] (($l2s_init . ⬦ ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))) & (~l2s_waiting | ~($l2s_w . ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))))) -> (true -> true)
~go[after i=22704091]: invariant [l2s_work_preserved] (l2s_saved & ($l2s_s . false)) -> false
~go[after i=22704091]: invariant [l2s_progress_made] (l2s_saved & ~($l2s_w . rfn.evqual(_M,_T))) -> (~($l2s_s . false) & false)
~go[after i=22704091]: invariant [l2s_progress_invar] ($l2s_init . □ ⬦ rfn.evqual(_M,_T)) -> □ ⬦ rfn.evqual(_M,_T)
~go[after i=22704091]: invariant [l2s_not_all_done] (~(($l2s_init . ⬦ ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))) & (~l2s_waiting | ~($l2s_w . ~(e2e.issued(_T,_M,_A) -> ⬦ rfn.evcomplete(_T))))) | ~(⬦ rfn.evqual(_M,_T) -> (true -> false)))
