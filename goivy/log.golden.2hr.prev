~go[after i=4493344]: invariant [invar405] ~memc.cpl_fair(_P,_M,_A,_T)
~go[after i=4493344]: invariant [l2s_needed_when_start] (($l2s_init . ⬦ ~(((_P = ref.evs.p(_T) & _M = ref.evs.m(_T)) & _A = ref.evs.a(_T)) -> (cf_pio_live.issued_pio_cpl_memc(_T) -> ⬦ ref.evs.l_cmp(_T) = if_l))) & (~l2s_waiting | ~($l2s_w . ~(((_P = ref.evs.p(_T) & _M = ref.evs.m(_T)) & _A = ref.evs.a(_T)) -> (cf_pio_live.issued_pio_cpl_memc(_T) -> ⬦ ref.evs.l_cmp(_T) = if_l))))) -> (true -> true)
~go[after i=4493344]: invariant [l2s_created] true -> true
~go[after i=4493344]: invariant [l2s_needed_are_frozen] (($l2s_init . ⬦ ~(((_P = ref.evs.p(_T) & _M = ref.evs.m(_T)) & _A = ref.evs.a(_T)) -> (cf_pio_live.issued_pio_cpl_memc(_T) -> ⬦ ref.evs.l_cmp(_T) = if_l))) & ~l2s_waiting) -> (true -> true)
~go[after i=4493344]: invariant [l2s_done_implies_created] false -> true
~go[after i=4493344]: invariant [l2s_needed_implies_created] (($l2s_init . ⬦ ~(((_P = ref.evs.p(_T) & _M = ref.evs.m(_T)) & _A = ref.evs.a(_T)) -> (cf_pio_live.issued_pio_cpl_memc(_T) -> ⬦ ref.evs.l_cmp(_T) = if_l))) & (~l2s_waiting | ~($l2s_w . ~(((_P = ref.evs.p(_T) & _M = ref.evs.m(_T)) & _A = ref.evs.a(_T)) -> (cf_pio_live.issued_pio_cpl_memc(_T) -> ⬦ ref.evs.l_cmp(_T) = if_l))))) -> (true -> true)
~go[after i=4493344]: invariant [l2s_work_preserved] (l2s_saved & ($l2s_s . false)) -> false
