{
  "name": "ivy-webui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:webui": "npm --prefix frontend run build",
    "typecheck:webui": "npm --prefix frontend run typecheck",
    "test:webui:js": "npm --prefix frontend run test",
    "test:webui:js:watch": "cd frontend && ../node_modules/.bin/vitest --watch --config vitest.config.mjs",
    "test:webui:all": "npm run test:webui:js",
    "test:webui:browser": "playwright test",
    "test:webui:browser:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "jsdom": "24.1.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.21.5",
    "@tanstack/table-core": "^8.21.3"
  }
}
