//(defmap snoopy)
(def s (snoopy))
(assert (== 
         ["EchoWeather func(*zlisp.Snoopy, *zlisp.Weather) *zlisp.Weather" "Fly func(*zlisp.Snoopy, *zlisp.Weather) (string, error)" "GetCry func(*zlisp.Snoopy) string" "Sideeffect func(*zlisp.Snoopy)"]
         (methodls s)))

(def f (fieldls s))
(assert (== f ["Plane zlisp.Plane" "Wings zlisp.Wings embed-path<Plane>" "SpanCm int embed-path<Plane:Wings>" "ID int embed-path<Plane>" "Speed int embed-path<Plane>" "Chld zlisp.Flyer embed-path<Plane>" "Friends []zlisp.Flyer embed-path<Plane>" "Cry string" "Pack []int" "Carrying []zlisp.Flyer"]))

