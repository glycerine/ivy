{
  "name": "ivy-webui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:webui": "npm --prefix goivy/webui/frontend run build",
    "test:webui:js": "npm run test:webui:vue",
    "test:webui:js:watch": "npm run test:webui:vue:watch",
    "test:webui:vue": "npm --prefix goivy/webui/frontend run test",
    "test:webui:vue:watch": "cd goivy/webui/frontend && ../../../node_modules/.bin/vitest --watch --config vitest.config.mjs",
    "test:webui:all": "npm run test:webui:vue",
    "test:webui:browser": "cd goivy/webui && ../../node_modules/.bin/playwright test",
    "test:webui:browser:headed": "cd goivy/webui && ../../node_modules/.bin/playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "24.1.3",
    "pinia": "^2.3.1",
    "vitest": "2.1.9",
    "vue": "^3.5.33"
  }
}
