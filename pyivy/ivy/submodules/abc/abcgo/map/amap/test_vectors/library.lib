library (demo) {
  /* comment */ cell (NAND2) {
    area : 1.25;
    dont_use : false;
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(Z) { direction : output; function : "!(A*B)"; }
    timing_table(foo) { values("1, 2", "3, 4"); }
  }
  cell (SKIP) { area: 2; dont_use:true; pin(Z) { function:"A"; } }
  cell (DFF) { area:3; ff(IQ, IQN) { next_state:"D"; } pin(Q) { function:"IQ"; } }
}
