#lang ivy1.8

# A whole-array assignment memb(A) := mema(A) in the clock-update logic. This
# copies the entire array in one cycle. The 32 entries exceed the register-bank
# limit and a RAM port can write one address per cycle. The translator reports
# "not a point write". See the 'to_rtl' regression in ivy_tests.py.

type addr
interpret addr -> bv[5]
type word
interpret word -> bv[8]

export action posedge

isolate top = {

    import wire read_addr_a : addr
    import wire read_addr_b : addr
    export wire out_a : word
    export wire out_b : word

    var mema(A:addr) : word
    var memb(A:addr) : word

    after posedge {
        memb(A) := mema(A)
    }

    definition out_a = mema(read_addr_a)
    definition out_b = memb(read_addr_b)
}
